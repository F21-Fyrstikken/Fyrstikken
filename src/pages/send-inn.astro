---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderImg from "../components/layout/HeaderImg.astro";
import { getCategoriesForSubmission } from "../lib/sanity-client";
import { SITE_CONFIG } from "../config";

const categories = await getCategoriesForSubmission(SITE_CONFIG.submissionYear);
const year = SITE_CONFIG.submissionYear;
---

<BaseLayout title="Send inn prosjekt — Fyrstikken">
  <HeaderImg variant="sendinn" slot="header" />
  <div class="submit-page">
    <header class="page-header">
      <h1>Send inn prosjekt</h1>
      <p>Fyll ut skjemaet under, så vil prosjektet bli gjennomgått av juryen for Fyrstikken {year}.</p>
    </header>

    <div id="form-wrapper">
      <form id="submit-form" method="POST" action="/api/submit" enctype="multipart/form-data">
        <!-- A) Medlemmer -->
        <div class="form-group">
          <label>Medlemmer <span class="required" aria-hidden="true">*</span></label>
          <div id="members-list">
            <div class="row-group member-row">
              <input type="text" class="member-name" placeholder="Fullt navn" required />
              <select class="member-class" required>
                <option value="" disabled selected>Velg klasse</option>
                <option value="1IMA">1IMA</option>
                <option value="1IMB">1IMB</option>
                <option value="1IMC">1IMC</option>
                <option value="2ITA">2ITA</option>
                <option value="2ITB">2ITB</option>
                <option value="2MP">2MP</option>
                <option value="1MKA">1MKA</option>
                <option value="1MKB">1MKB</option>
                <option value="2MKA">2MKA</option>
                <option value="2MKB">2MKB</option>
                <option value="3MKA">3MKA</option>
                <option value="3MKB">3MKB</option>
                <option value="IMT">IMT</option>
              </select>
              <button
                type="button"
                class="remove-btn remove-member"
                aria-label="Fjern medlem"
                style="visibility: hidden;">Fjern</button
              >
            </div>
          </div>
          <button type="button" id="add-member-btn" class="outline-btn">Legg til medlem</button>
        </div>
        <!-- B) Tittel -->
        <div class="form-group">
          <label for="tittel">Tittel <span class="required" aria-hidden="true">*</span></label>
          <input type="text" id="tittel" name="title" required />
        </div>

        <!-- C: Prosjektbeskrivelse -->
        <div class="form-group">
          <label for="prosjektbeskrivelse">Prosjektbeskrivelse</label>
          <p class="field-hint">
            Forklar kort hva prosjektet ditt handler om, hvilken tankegang du har hatt, eller tekniske detaljer som ikke
            fremgår direkte av bildet/videoen.
          </p>
          <textarea
            id="prosjektbeskrivelse"
            name="projectDescription"
            rows="3"
            maxlength="2000"
            placeholder="(Valgfritt) beskriv prosjektet ditt..."></textarea>
        </div>

        <!-- D) Kategori -->
        <div class="form-group">
          <label for="kategori">Kategori <span class="required" aria-hidden="true">*</span></label>
          <p class="field-hint">
            Velg kategorien som er nærmest prosjektet sjanger. Prosjekter som leveres i feil kategori, korrigeres i
            ettertid av juryen.
          </p>
          <select id="kategori" name="category" required>
            <option value="" disabled selected>Velg en kategori</option>
            {
              categories.map((cat: { _id: string; title: string }) => (
                <option value={cat._id} data-title={cat.title}>
                  {cat.title}
                </option>
              ))
            }
          </select>
        </div>

        <!-- E) Filer -->
        <div class="form-group" id="files-group" hidden>
          <label>Filer</label>
          <p class="field-hint" id="files-hint">
            For denne kategorien kan du laste opp filer, legge til en YouTube-/Vimeo-lenke, eller bruke begge deler.
          </p>
          <div id="attachments-list">
            <!-- Dynamisk lagt til med JS -->
          </div>
          <button type="button" id="add-attachment-btn" class="outline-btn">Legg til fil</button>
        </div>
        <div class="form-group" id="youtube-group" hidden>
          <label for="video-url">YouTube/Vimeo-lenke</label>
          <p class="field-hint">
            Videofiler over 100MB må sendes inn som en YouTube- eller Vimeo-lenke. Sørg for at videoen er publisert
            eller satt til «ikke oppført», slik at juryen kan se den.
          </p>
          <input
            type="url"
            id="video-url"
            name="videoUrl"
            placeholder="https://www.youtube.com/watch?v=... eller https://vimeo.com/..."
            inputmode="url"
          />
        </div>
        <!-- F) Visningsbilde -->
        <div class="form-group">
          <label for="prosjektbilde">Visningsbilde <span class="required" aria-hidden="true">*</span></label>
          <p class="field-hint">
            Dette bildet brukes som forhåndsvisningsbilde for prosjektet ditt og er det første man ser. Anbefalt format:
            16:9 (f.eks. 1920x1080, 960x540, 640x360). Aksepterte filtyper: JPG, PNG eller WebP.
          </p>
          <input type="file" id="prosjektbilde" name="image" accept="image/jpeg,image/png,image/webp" required />
        </div>

        <!-- G) Submit Actions -->
        <div class="form-actions">
          <button type="submit" id="submit-btn" class="submit-btn">Send inn prosjekt</button>
        </div>

        <div id="form-error" class="error-msg" hidden></div>
      </form>
    </div>

    <div id="success-msg" class="success-msg" hidden>
      <h2>Takk!</h2>
      <p>Prosjektet ditt er sendt inn! Det vil bli gjennomgått av juryen.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .submit-page {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-xl, 3.2rem) var(--space-md, 1.6rem);
  }

  .page-header {
    margin-bottom: var(--space-xl, 3.2rem);
    text-align: center;
  }

  .page-header h1 {
    font-size: 3.2rem;
    margin-bottom: var(--space-sm, 0.8rem);
    color: light-dark(var(--light-tekst), var(--dark-tekst));
  }

  .page-header p {
    font-size: 1.8rem;
    line-height: 1.5;
    color: light-dark(var(--light-tekst), var(--dark-tekst));
    opacity: 0.8;
  }
  #form-wrapper {
    margin-bottom: 10rem;
  }

  .form-group {
    margin-bottom: var(--space-lg, 2.4rem);
  }

  label {
    display: block;
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: var(--space-xs, 0.4rem);
    color: light-dark(var(--light-tekst), var(--dark-tekst));
  }

  .required {
    color: light-dark(var(--light-rubin), var(--dark-rubin));
  }

  .field-hint {
    font-size: 1.4rem;
    line-height: 1.5;
    color: light-dark(var(--light-tekst), var(--dark-tekst));
    opacity: 0.7;
    margin-bottom: var(--space-xs, 0.4rem);
  }

  input[type="text"],
  input[type="url"],
  select,
  input[type="file"] {
    height: 4rem;
    display: block;
    width: 100%;
    background: light-dark(var(--light-ixDBoks), var(--dark-ixDBoks));
    border: 1px solid light-dark(var(--light-ramme), var(--dark-ramme));
    color: light-dark(var(--light-tekst), var(--dark-tekst));
    border-radius: var(--radius-md, 8px);
    padding: var(--space-sm, 0.8rem) var(--space-md, 1.6rem);
    font-size: 1.6rem;
    font-family: inherit;
    transition: border-color var(--transition-fast, 0.2s ease);
    box-sizing: border-box;
  }

  input[type="file"] {
    padding: var(--space-sm, 0.8rem);
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: light-dark(var(--light-safir), var(--dark-safir));
  }

  textarea {
    width: 100%;
    min-height: 90px;
    background: light-dark(var(--light-ixDBoks), var(--dark-ixDBoks));
    border: 1px solid light-dark(var(--light-ramme), var(--dark-ramme));
    color: light-dark(var(--light-tekst), var(--dark-tekst));
    border-radius: var(--radius-md, 8px);
    padding: var(--space-sm, 0.8rem) var(--space-md, 1.6rem);
    font-size: 1.6rem;
    font-family: inherit;
    resize: vertical; /* Lar brukeren endre høyden, ikke bredden */
    transition: border-color var(--transition-fast, 0.2s ease);
    box-sizing: border-box;
  }

  textarea:focus {
    outline: none;
    border-color: light-dark(var(--light-safir), var(--dark-safir));
  }

  /* Dynamiske Rader (Row-Groups) */
  .row-group {
    display: flex;
    gap: var(--space-sm, 0.8rem);
    margin-bottom: var(--space-sm, 0.8rem);
    align-items: center;
    width: 100%;
  }

  .member-row input,
  .member-row select {
    flex: 1;
    min-width: 0;
  }

  .attachment-row input[type="file"] {
    flex: 1;
    min-width: 0;
  }

  #add-attachment-btn {
    background: light-dark(var(--light-ixDBoks), var(--dark-ixDBoks));
  }
  .outline-btn {
    display: inline-block;
    background: transparent;
    color: light-dark(var(--light-tekst), var(--dark-tekst));
    border: 1px solid light-dark(var(--light-ramme), var(--dark-ramme));
    border-radius: var(--radius-md, 8px);
    padding: var(--space-xs, 0.4rem) var(--space-md, 1.6rem);
    font-size: 1.4rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast, 0.2s ease);
    margin-top: var(--space-xs, 0.4rem);
  }

  .outline-btn:hover {
    border-color: light-dark(var(--light-safir), var(--dark-safir));
    color: light-dark(var(--light-safir), var(--dark-safir));
  }

  .remove-btn {
    background: transparent;
    border: none;
    color: light-dark(var(--light-rubin), var(--dark-rubin));
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    padding: var(--space-xs, 0.4rem);
    opacity: 0.8;
    transition: opacity var(--transition-fast, 0.2s ease);
    flex-shrink: 0;
  }

  .remove-btn:hover {
    opacity: 1;
  }

  /* Prevent clicks on hidden remove buttons */
  .remove-btn[style*="visibility: hidden"] {
    pointer-events: none;
  }

  .form-actions {
    margin-top: var(--space-xl, 3.2rem);
  }

  .submit-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    background: light-dark(var(--light-safir), var(--dark-safir));
    color: #ffffff;
    border: none;
    border-radius: var(--radius-md, 8px);
    padding: var(--space-md, 1.6rem) var(--space-lg, 2.4rem);
    font-size: 1.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform var(--transition-fast, 0.2s ease),
      opacity var(--transition-fast, 0.2s ease);
  }

  .submit-btn:hover {
    transform: translateY(-2px);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .error-msg {
    margin-top: var(--space-md, 1.6rem);
    padding: var(--space-md, 1.6rem);
    background: light-dark(var(--light-rubin), var(--dark-rubin));
    color: #ffffff;
    border-radius: var(--radius-md, 8px);
    font-size: 1.4rem;
    text-align: center;
  }

  .success-msg {
    text-align: center;
    padding: var(--space-xl, 3.2rem);
    background: light-dark(var(--light-ixDBoks), var(--dark-ixDBoks));
    border-radius: var(--radius-lg, 12px);
    border: 1px solid light-dark(var(--light-ramme), var(--dark-ramme));
  }

  .success-msg h2 {
    color: light-dark(var(--light-amazonitt), var(--dark-amazonitt));
    margin-bottom: var(--space-sm, 0.8rem);
    font-size: 2.4rem;
  }

  .success-msg p {
    font-size: 1.8rem;
    color: light-dark(var(--light-tekst), var(--dark-tekst));
  }
</style>

<script>
  const form = document.getElementById("submit-form") as HTMLFormElement | null;
  const formWrapper = document.getElementById("form-wrapper");
  const successMsg = document.getElementById("success-msg");
  const errorMsg = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const categorySelect = document.getElementById("kategori") as HTMLSelectElement | null;
  const filesGroup = document.getElementById("files-group");
  const youtubeGroup = document.getElementById("youtube-group");
  const videoInput = document.getElementById("video-url") as HTMLInputElement | null;

  //GAMMEL FUNKSJON: Usikker på om denne fremdeles er nødvendig
  function requiresVideoUrl(): boolean {
    const selectedOption = categorySelect?.selectedOptions[0];
    const categoryTitle = selectedOption?.dataset.title ?? selectedOption?.textContent ?? "";
    return categoryTitle.trim().toLowerCase().includes("film");
  }

  // NY FUNKSJON: Sjekk om kategorien støtter hybrid-innsending (video OG/ELLER filer)
  function supportsHybridSubmission(): boolean {
    const selectedOption = categorySelect?.selectedOptions[0];
    const categoryTitle = selectedOption?.dataset.title ?? selectedOption?.textContent ?? "";
    const lowerTitle = categoryTitle.trim().toLowerCase();

    return (
      lowerTitle.includes("film") ||
      lowerTitle === "lyddesign" ||
      lowerTitle === "reklame" ||
      lowerTitle === "spillutvikling" ||
      lowerTitle === "animasjon" ||
      lowerTitle === "grafisk design" ||
      lowerTitle === "journalistikk" ||
      lowerTitle === "web og interaktivitet"
    );
  }
  function hasSelectedCategory(): boolean {
    return (categorySelect?.value ?? "") !== "";
  }

  function updateDeliveryFields(): void {
    const categorySelected = hasSelectedCategory();
    const isHybrid = supportsHybridSubmission();
    const requiresVideo = requiresVideoUrl();

    if (filesGroup) {
      // Vis fil-feltet hvis kategori er valgt
      // For hybrid-kategorier: alltid vis
      // For ikke-hybrid: vis kun hvis ikke krever video
      filesGroup.hidden = !categorySelected || (requiresVideo && !isHybrid);
    }

    if (youtubeGroup && videoInput) {
      // Vis video-feltet for film-kategorier OG hybrid-kategorier
      youtubeGroup.hidden = !categorySelected || (!requiresVideo && !isHybrid);

      // Video-input er kun påkrevd hvis det er en ren film-kategori (ikke hybrid)
      // For hybrid: ikke påkrevd siden det er OR-validering
      videoInput.required = requiresVideo && !isHybrid;

      if (!requiresVideo && !isHybrid) {
        videoInput.value = "";
      }
    }
  }
  // Legg til etter categorySelect?.addEventListener("change", updateDeliveryFields);
  categorySelect?.addEventListener("change", () => {
    updateDeliveryFields();

    // Oppdater hint-tekst for fil-feltet basert på kategori
    const filesHint = document.getElementById("files-hint");
    if (filesHint && supportsHybridSubmission()) {
      filesHint.textContent =
        "For denne kategorien kan du laste opp filer, legge til en YouTube-/Vimeo-lenke, eller bruke begge deler.";
    } else if (filesHint) {
      filesHint.textContent = "Last opp filer som er relevant for prosjektet ditt.";
    }
  });

  // Medlemmer Logikk
  const membersList = document.getElementById("members-list");
  const addMemberBtn = document.getElementById("add-member-btn");

  if (membersList && addMemberBtn) {
    addMemberBtn.addEventListener("click", () => {
      const rows = membersList.querySelectorAll(".member-row");
      if (rows.length > 0) {
        const firstRow = rows[0] as HTMLElement;
        const newRow = firstRow.cloneNode(true) as HTMLElement;

        const inputs = newRow.querySelectorAll("input");
        inputs.forEach((input) => (input.value = ""));

        const selects = newRow.querySelectorAll("select");
        selects.forEach((select) => (select.value = ""));

        const removeBtn = newRow.querySelector(".remove-btn") as HTMLButtonElement;
        if (removeBtn) {
          removeBtn.style.visibility = "visible";
        }

        membersList.appendChild(newRow);
      }
    });

    membersList.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains("remove-member")) {
        const rows = membersList.querySelectorAll(".member-row");
        if (rows.length > 1) {
          target.closest(".member-row")?.remove();
        }
      }
    });
  }

  function serializeMembers(): string {
    if (!membersList) return "";
    const rows = membersList.querySelectorAll(".member-row");
    const parts: string[] = [];
    rows.forEach((row) => {
      const name = (row.querySelector(".member-name") as HTMLInputElement)?.value.trim() ?? "";
      const cls = (row.querySelector(".member-class") as HTMLInputElement)?.value.trim() ?? "";
      if (name !== "" && cls !== "") {
        parts.push(`${name} ${cls}`);
      }
    });
    return parts.join(", ");
  }

  // Filer og Lenker Logikk
  const attachmentsList = document.getElementById("attachments-list");
  const addAttachmentBtn = document.getElementById("add-attachment-btn");

  if (attachmentsList && addAttachmentBtn) {
    addAttachmentBtn.addEventListener("click", () => {
      const div = document.createElement("div");
      div.className = "row-group attachment-row";
      div.innerHTML = `
        <input type="file" name="attachment[]" class="attachment-file" />
        <button type="button" class="remove-btn remove-attachment" aria-label="Fjern fil">Fjern</button>
      `;
      attachmentsList.appendChild(div);
    });

    attachmentsList.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains("remove-attachment")) {
        target.closest(".attachment-row")?.remove();
      }
    });
  }

  // Submit Handler
  if (form && formWrapper && successMsg && errorMsg && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const originalBtnText = submitBtn.textContent || "Send inn prosjekt";
      submitBtn.disabled = true;
      submitBtn.textContent = "Sender...";
      errorMsg.hidden = true;
      errorMsg.textContent = "";

      try {
        const members = serializeMembers();
        if (members === "") {
          throw new Error("Minst ett medlem (navn og klasse) er påkrevd.");
        }

        const title = (document.getElementById("tittel") as HTMLInputElement).value.trim();
        if (title === "") {
          throw new Error("Tittel er påkrevd.");
        }

        const category = (document.getElementById("kategori") as HTMLSelectElement).value;
        if (category === "") {
          throw new Error("Kategori er påkrevd.");
        }

        const formData = new FormData(form);

        const videoUrl = videoInput?.value.trim() ?? "";
        const attachments = formData.getAll("attachment[]");
        const hasVideo = videoUrl !== "";
        const hasFiles = attachments.some((f) => f instanceof File && f.size > 0);

        const isHybrid = supportsHybridSubmission();
        const requiresVideoOnly = requiresVideoUrl() && !isHybrid;

        if (isHybrid) {
          // HYBRID-MODE: OR-validering - minst ett av video eller filer må være utfylt
          if (!hasVideo && !hasFiles) {
            throw new Error("Du må laste opp minst én fil eller legge inn en YouTube-/Vimeo-lenke.");
          }

          // Legg til begge hvis de finnes
          if (hasVideo) {
            formData.set("videoUrl", videoUrl);
          }
          // Filer beholdes automatisk i formData
        } else if (requiresVideoOnly) {
          // REN VIDEO-MODE: Kun video-lenke kreves
          if (!hasVideo) {
            throw new Error("Du må legge inn en YouTube- eller Vimeo-lenke for filmprosjekter.");
          }
          formData.set("videoUrl", videoUrl);
          formData.delete("attachment[]");
        } else {
          // REN FIL-MODE: Kun filer kreves
          if (!hasFiles) {
            throw new Error("Du må laste opp minst én fil.");
          }
          formData.delete("videoUrl");
        }

        formData.append("members", members);

        const response = await fetch(form.action, {
          method: form.method,
          body: formData,
        });

        if (response.ok) {
          formWrapper.hidden = true;
          successMsg.hidden = false;
        } else {
          let errorText = "Noe gikk galt ved innsending.";
          try {
            const data = await response.json();
            if (data.message) {
              errorText = data.message;
            } else if (data.error) {
              errorText = data.error;
            }
          } catch (parseError) {
            // response was not JSON or failed to parse
          }
          throw new Error(errorText);
        }
      } catch (err) {
        if (err instanceof Error) {
          errorMsg.textContent = err.message;
        } else {
          errorMsg.textContent = "En ukjent feil oppstod.";
        }
        errorMsg.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    });
  }
</script>
